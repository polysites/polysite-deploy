# /etc/polysite/polysite.env: read by both services (mode 640, owner root, group polysite). Every variable: the Polysite configuration guide.
# install.sh creates it from this file with fresh secrets; see ./scripts/install.sh.

CMS_DOMAIN=admin.example.org
CMS_SCHEME=https
SITE_DOMAIN=www.example.org
SITE_SCHEME=https

# Secrets: openssl rand -base64 48. PAYLOAD_SECRET must never change on a running install. REVALIDATE_SECRET and NUXT_REVALIDATE_SECRET must be equal.
PAYLOAD_SECRET=
REVALIDATE_SECRET=
NUXT_REVALIDATE_SECRET=
# Required over https: asked for on the first-run page.
POLYSITE_SETUP_TOKEN=

# PostgreSQL on this machine (or a managed one). The user needs CREATEDB.
DATABASE_URL=postgres://polysite:CHANGE_ME@127.0.0.1:5432/polysite

# How the two services reach each other: loopback, not Docker names.
NUXT_PUBLIC_API_BASE=/api
NUXT_API_BASE_INTERNAL=http://127.0.0.1:3001/api
NUXT_REVALIDATE_URL=http://127.0.0.1:3000/api/revalidate
# Read at runtime by the web app (what the BROWSER sees as the admin).
NUXT_PUBLIC_CMS_SERVER_URL=https://admin.example.org

# Optional: POLYSITE_MAX_UPLOAD_MB, SMTP_HOST/PORT/USER/PASS, OTEL_EXPORTER_OTLP_ENDPOINT ...
