# Copy to .env (or run ./init.sh, which writes it with fresh secrets). Never commit .env.
# Every variable is explained in the Polysite docs: https://polysites.github.io/polysite/guide/configuration

# --- Addresses. Real DNS names pointing at this server; Caddy gets a certificate for each by itself.
SITE_DOMAIN=www.example.org
CMS_DOMAIN=admin.example.org
SITE_SCHEME=https
CMS_SCHEME=https

# --- Secrets. With https the CMS refuses to start on placeholders or values under 32 characters.
# Generate each with:  openssl rand -base64 48      PAYLOAD_SECRET must never change on a running install.
PAYLOAD_SECRET=
REVALIDATE_SECRET=
NUXT_REVALIDATE_SECRET=
# Required over https: asked for on the first-run page, so only you can create the first administrator.
POLYSITE_SETUP_TOKEN=

# --- Database (the db container in docker-compose.yml). DATABASE_URL must use the same password.
POSTGRES_USER=polysite
POSTGRES_PASSWORD=
POSTGRES_DB=polysite
DATABASE_URL=postgres://polysite:CHANGE_ME_TO_THE_SAME_PASSWORD@db:5432/polysite

# --- How the apps reach each other (leave as they are)
NUXT_PUBLIC_API_BASE=/api
NUXT_API_BASE_INTERNAL=http://cms:3001/api
NUXT_REVALIDATE_URL=http://web:3000/api/revalidate

# --- Registry for the images (default: the project's). Change only for a mirror of your own.
# POLYSITE_REGISTRY=ghcr.io/polysites

# --- Backups (nightly 03:17 UTC, kept 7 days / 4 weeks / 6 months, a test restore every Sunday)
# BACKUP_HOST_DIR=./backups
# An off-site copy is sent only if encrypted: both of these, a passphrase of 16+ characters stored somewhere other than this server.
# BACKUP_RCLONE_REMOTE=offsite:my-bucket/polysite
# BACKUP_ENCRYPTION_PASSPHRASE=
# RCLONE_CONFIG_OFFSITE_TYPE=s3
# RCLONE_CONFIG_OFFSITE_PROVIDER=AWS
# RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
# RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
# RCLONE_CONFIG_OFFSITE_REGION=us-east-1
# BACKUP_PING_URL=

# --- Optional: email (SMTP), telemetry. See the configuration page of the docs.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
